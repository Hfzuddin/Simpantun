# Origin of the Flask backend. Leave unset for local dev (Vite proxies /api to
# 127.0.0.1:5500) and for the Docker image (Flask serves the frontend itself).
# Set this in the Vercel project settings to the Hugging Face Space URL, with
# no trailing slash:
VITE_API_BASE=https://<user>-simpantun.hf.space
